{
  "name": "eco-terminal",
  "private": true,
  "version": "1.0.0",
  "description": "Eco Terminal — Authoritative Environmental Intelligence and Data Centre Siting Decision Support Platform for India",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "backend": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000 --app-dir backend",
    "db:init": "backend\\.venv\\Scripts\\python.exe -m backend.scripts.init_db",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "backend\\.venv\\Scripts\\python.exe -m unittest discover -s backend/tests -p \"test_*.py\"",
    "test:frontend": "npm --prefix frontend test",
    "preview": "npm --prefix frontend run preview"
  }
}
