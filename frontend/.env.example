# Frontend Vite configuration; use frontend/.env.local for local overrides.
# API URL prefix used in API mode; demo mode is selected in the UI.
VITE_API_BASE_URL=/api/v1

# Optional public Mapbox basemap token; defaults to CARTO/ESRI when absent.
# VITE_MAPBOX_TOKEN=your_public_mapbox_token

# VITE_MAP_STYLE_URL is not consumed by the current application.
# All VITE_* values are browser-visible. Do not put private API keys here.
