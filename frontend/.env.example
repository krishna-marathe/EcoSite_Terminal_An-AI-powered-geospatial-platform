# EcoSite Terminal Environment Configuration
# Base URL for the Python FastAPI backend service
# Leave empty or set to /api/v1 to use built-in synthetic demonstration data adapter
VITE_API_BASE_URL=/api/v1

# Optional MapLibre Vector Tile Style or CARTO Tile URL
# Defaults to free public CARTO Dark Matter style if omitted
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Optional Gemini API key for future direct generative AI integration
# (Normally accessed via secure FastAPI backend proxy)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
