# Read from the process, or pass --env-file backend/.env to Uvicorn from the repo root.
# Leave ECOSITE_DB_PATH unset for the application-relative backend/data/ecosite.db.
# If overriding, use an absolute path; relative paths depend on the launch directory.
# ECOSITE_DB_PATH=C:/path/to/ecosite.db
ECOSITE_CORS_ORIGINS=http://localhost:5173
ECOSITE_API_PREFIX=/api/v1

# Set a strong secret to enable ingestion; an empty value disables writes.
ECOSITE_INGESTION_KEY=

# ---------------------------------------------------------------------------
# Roadmap P0 connectors (JRC, NASA SRTMGL1, Copernicus STAC)
# ---------------------------------------------------------------------------
# NASA Earthdata token for SRTMGL1. Required before SRTM can be ingested.
# Create one at https://urs.earthdata.nasa.gov/ and keep it out of version control.
ECOSITE_EARTHDATA_TOKEN=

# Optional overrides. The defaults are the public release locations verified in
# the source audit. Change these only when a release moves or a mirror is used.
# ECOSITE_JRC_GSW_BASE_URL=https://s3.waw4-1.cloudferro.com/swift/v1/global-surface-water/download2024/Aggregated/VER1-5/occurrence
# ECOSITE_SRTM_BASE_URL=https://e4ftl01.cr.usgs.gov/MEASURES/SRTMGL1.003/2000.02.11
# ECOSITE_STAC_SEARCH_URL=https://catalogue.dataspace.copernicus.eu/stac/search

# Historical water-occurrence threshold in percent (default 1).
# ECOSITE_JRC_WATER_THRESHOLD=1

# Copernicus STAC scene search: lookback window and cloud-cover threshold.
# The search is anonymous; downloading Sentinel-2 assets requires a CDSE account.
# ECOSITE_STAC_LOOKBACK_DAYS=365
# ECOSITE_STAC_MAX_CLOUD=20

# Where gzipped raw source snapshots are stored. Defaults to backend/data/raw.
# ECOSITE_RAW_DIR=C:/path/to/raw

