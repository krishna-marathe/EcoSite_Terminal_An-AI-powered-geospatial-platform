{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "EcoTerminal: frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "EcoTerminal: backend",
			"type": "shell",
			"command": "C:/Users/marat/EcoTerminal/backend/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000",
				"--app-dir",
				"backend"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}